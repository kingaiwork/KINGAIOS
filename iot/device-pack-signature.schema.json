{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.kingai.work/schema/device-pack-signature-v1.json",
  "title": "KINGAI OS Device Pack Detached Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key_id", "signature"],
  "properties": {
    "schema": {"const": 1},
    "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "signature": {"type": "string", "minLength": 80, "maxLength": 128}
  }
}
