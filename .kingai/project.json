{
  "schema": "kingai.project.v1",
  "product_id": "kingai-os",
  "name": "KINGAI OS",
  "role": "local-os-runtime",
  "visibility": "public",
  "website_repo": "kingaiwork/Kingaiosweb",
  "governance_source": "kingaiwork/KINGAIASE",
  "platform": {
    "api_origin": "https://api.kingai.work",
    "identity_mode": "local-runtime-plus-federated-cloud",
    "direct_core_data_access": false,
    "cloud_identity_authority": false,
    "cloud_billing_authority": false
  },
  "runtime": {
    "authority": "device-local-policy",
    "management_transport": "unix-socket-by-default",
    "data": "local-runtime",
    "offline_survival": true,
    "cloud_survival_dependency": false
  },
  "boundaries": {
    "server": "local OS/runtime",
    "desktop": "personal-computer runtime",
    "iot_edge": "device runtime",
    "container": "OCI deployment form",
    "ops_relationship": "KINGAI OPS coordinates; KINGAI OS/local Linux keeps local execution authority",
    "agent_relationship": "KINGAIBOT/OpenClaw/MCP/Codex are governed execution adapters, not cloud identity authorities"
  }
}
