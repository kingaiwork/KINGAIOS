#!/usr/bin/env bash
set -euo pipefail

TITLE="Install KINGAI OS"

if ! grep -Eq '(^| )boot=casper( |$)' /proc/cmdline; then
  kdialog --title "$TITLE" --error "The installer can only run from a KINGAI OS Live USB session."
  exit 1
fi
for tool in kdialog jq lsblk numfmt sudo; do
  command -v "$tool" >/dev/null || { kdialog --title "$TITLE" --error "Required installer component is missing: $tool"; exit 1; }
done

kdialog --title "$TITLE" --yesno \
  "Install KINGAI OS Desktop on this PC?\n\nYou can continue using the Live system without installing. The selected internal disk will be completely erased only after a final confirmation." || exit 0

json=$(kingai-install --list)
mapfile -t disks < <(jq -r '
  def hasmount:
    (((.mountpoints // []) | any(. != null and . != ""))) or
    (((.children // []) | any(hasmount)));
  .[] |
  select(.type == "disk" and (.ro|not) and (.rm|not) and (.size >= 42949672960) and ((hasmount)|not)) |
  [.path, (.model // "Internal disk"), (.size|tostring)] | @tsv
' <<<"$json")

if (( ${#disks[@]} == 0 )); then
  kdialog --title "$TITLE" --error \
    "No safe unmounted internal disk of at least 40 GiB was found.\n\nExternal/removable disks and disks with mounted partitions are intentionally excluded."
  exit 1
fi

menu_args=()
for row in "${disks[@]}"; do
  IFS=$'\t' read -r path model bytes <<<"$row"
  human=$(numfmt --to=iec-i --suffix=B "$bytes")
  model=${model:-Internal disk}
  menu_args+=("$path" "$model — $human")
done

target=$(kdialog --title "$TITLE" --menu "Choose the internal disk for KINGAI OS:" "${menu_args[@]}") || exit 0
selected=""
for row in "${disks[@]}"; do
  IFS=$'\t' read -r path model bytes <<<"$row"
  if [[ "$path" == "$target" ]]; then selected="$model — $(numfmt --to=iec-i --suffix=B "$bytes")"; break; fi
done
[[ -n "$selected" ]] || { kdialog --title "$TITLE" --error "The selected disk is no longer available."; exit 1; }

while :; do
  username=$(kdialog --title "$TITLE" --inputbox "Choose your username:" "kingai") || exit 0
  if [[ "$username" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]]; then break; fi
  kdialog --title "$TITLE" --sorry "Use lowercase letters, numbers, _ or -, beginning with a letter or _."
done

while :; do
  hostname_value=$(kdialog --title "$TITLE" --inputbox "Computer name:" "kingai-pc") || exit 0
  if [[ "$hostname_value" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ && "$hostname_value" != *..* ]]; then break; fi
  kdialog --title "$TITLE" --sorry "Enter a valid computer name such as kingai-pc."
done

while :; do
  user_pass1=$(kdialog --title "$TITLE" --password "Create your Desktop login password (12+ characters):") || exit 0
  (( ${#user_pass1} >= 12 )) || { kdialog --title "$TITLE" --sorry "The login password must contain at least 12 characters."; continue; }
  user_pass2=$(kdialog --title "$TITLE" --password "Repeat your Desktop login password:") || exit 0
  [[ "$user_pass1" == "$user_pass2" ]] && break
  kdialog --title "$TITLE" --sorry "The Desktop passwords do not match."
done

while :; do
  state_pass1=$(kdialog --title "$TITLE" --password "Create the encrypted data unlock passphrase (32+ characters):") || exit 0
  (( ${#state_pass1} >= 32 )) || { kdialog --title "$TITLE" --sorry "The encrypted data passphrase must contain at least 32 characters."; continue; }
  state_pass2=$(kdialog --title "$TITLE" --password "Repeat the encrypted data unlock passphrase:") || exit 0
  [[ "$state_pass1" == "$state_pass2" ]] && break
  kdialog --title "$TITLE" --sorry "The encrypted data passphrases do not match."
done

locale_value=${LANG:-en_US.UTF-8}
locale_value=${locale_value%%:*}
[[ "$locale_value" =~ ^[A-Za-z0-9_.@-]+$ ]] || locale_value=en_US.UTF-8
timezone_value=$(timedatectl show -p Timezone --value 2>/dev/null || true)
[[ "$timezone_value" =~ ^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+){0,3}$ ]] || timezone_value=UTC

warning="This is the final destructive step.\n\nDisk: $target\nDevice: $selected\nUser: $username\nComputer: $hostname_value\nEncrypted personal data: enabled\nA/B system rollback: enabled\n\nALL existing partitions and files on $target will be permanently erased."
kdialog --title "$TITLE" --warningyesno "$warning" || exit 0

runtime_dir=$(mktemp -d /tmp/kingai-gui-install.XXXXXX)
umask 077
state_key="$runtime_dir/state.key"
password_file="$runtime_dir/user.password"
log_file="$runtime_dir/install.log"
printf '%s' "$state_pass1" > "$state_key"
printf '%s' "$user_pass1" > "$password_file"
chmod 0600 "$state_key" "$password_file"
unset state_pass1 state_pass2 user_pass1 user_pass2

cleanup() {
  set +e
  rm -f "$state_key" "$password_file"
  # Keep a failure log only for the current Live session; it contains no passwords.
  [[ -f "$log_file" && ! -s "$log_file" ]] && rm -f "$log_file"
}
trap cleanup EXIT INT TERM

kdialog --title "$TITLE" --passivepopup "Installing KINGAI OS. Do not power off this PC." 8 || true
set +e
sudo /usr/sbin/kingai-install \
  --target "$target" \
  --profile desktop \
  --state-key "$state_key" \
  --username "$username" \
  --hostname "$hostname_value" \
  --user-password-file "$password_file" \
  --locale "$locale_value" \
  --timezone "$timezone_value" \
  --confirm "ERASE:$target" >"$log_file" 2>&1
code=$?
set -e

if (( code != 0 )); then
  kdialog --title "$TITLE" --error "Installation failed safely. The diagnostic log will open next."
  kdialog --title "KINGAI OS Installer Log" --textbox "$log_file" 900 650 || true
  exit "$code"
fi

rm -f "$state_key" "$password_file"
kdialog --title "$TITLE" --yesno \
  "KINGAI OS was installed successfully.\n\nRemove the Live USB when the PC restarts. Restart now?"
if [[ $? -eq 0 ]]; then
  sudo systemctl reboot
fi
