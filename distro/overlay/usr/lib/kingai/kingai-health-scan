#!/bin/sh
set -eu

out_dir=/var/lib/kingai/health
out="$out_dir/latest.json"
mkdir -p "$out_dir"
chmod 0755 "$out_dir"

tmp=$(mktemp "$out_dir/.latest.XXXXXX")
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT HUP INT TERM

# The periodic root-owned scan may execute only the compiled safe-auto
# remediation allowlist. High-risk actions remain observe/approval/manual and
# are never executed by this timer. A critical diagnostic intentionally exits
# non-zero; preserve its structured report for the control plane regardless.
set +e
/usr/bin/kingai doctor --repair-safe --json >"$tmp"
rc=$?
set -e

if [ ! -s "$tmp" ]; then
  echo "KINGAI health scan produced no report (doctor rc=$rc)" >&2
  exit 1
fi
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT HUP INT TERM

# Do not convert a diagnosed critical state into a failed systemd timer. The
# report carries severity, action IDs, remediation modes and any safe repairs;
# policy-controlled agents can act on it without restart loops or escalation.
exit 0
