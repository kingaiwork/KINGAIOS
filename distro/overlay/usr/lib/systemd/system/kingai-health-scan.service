[Unit]
Description=KINGAI OS Health Intelligence Snapshot
Documentation=https://os.kingai.work/docs
After=local-fs.target kingaid.service
Wants=kingaid.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/kingai/kingai-health-scan
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/kingai
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
