{
  "schema": 1,
  "name": "KINGAI OS Edge Capability Catalog",
  "operation_risk_floors": {"read":"L0","write":"L1","compute":"L1","control":"L3","reset":"L4","update":"L5"},
  "resource_risk_floors": {"sensor":"L0","telemetry":"L0","gpio":"L1","i2c":"L1","spi":"L1","uart":"L1","camera":"L1","gpu":"L1","npu":"L1","accelerator":"L1","microphone":"L2","location":"L2","network":"L2","storage":"L2","safety":"L3","motor":"L4","actuator":"L4","relay":"L4","power":"L4","firmware":"L5","boot":"L5","flash":"L5"},
  "canonical_capabilities": [
    {"id":"device.telemetry.read","operation":"read","resource":"sensor:<id>"},
    {"id":"device.gpio.read","operation":"read","resource":"gpio:<line>"},
    {"id":"device.gpio.write","operation":"write","resource":"gpio:<line>"},
    {"id":"device.i2c.read","operation":"read","resource":"i2c:<bus>@<address>"},
    {"id":"device.i2c.write","operation":"write","resource":"i2c:<bus>@<address>"},
    {"id":"device.spi.read","operation":"read","resource":"spi:<bus>"},
    {"id":"device.spi.write","operation":"write","resource":"spi:<bus>"},
    {"id":"device.uart.read","operation":"read","resource":"uart:<port>"},
    {"id":"device.uart.write","operation":"write","resource":"uart:<port>"},
    {"id":"device.camera.capture","operation":"read","resource":"camera:<id>"},
    {"id":"device.microphone.capture","operation":"read","resource":"microphone:<id>"},
    {"id":"device.gpu.compute","operation":"compute","resource":"gpu:<id>"},
    {"id":"device.npu.compute","operation":"compute","resource":"npu:<id>"},
    {"id":"device.motor.control","operation":"control","resource":"motor:<id>"},
    {"id":"device.actuator.control","operation":"control","resource":"actuator:<id>"},
    {"id":"device.power.control","operation":"control","resource":"power:<id>"},
    {"id":"device.firmware.update","operation":"update","resource":"firmware:<id>"}
  ],
  "rule": "A Device Pack may declare a higher risk than the catalog floor, never a lower one. High-risk mutating operations require Approval."
}
