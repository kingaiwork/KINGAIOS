[Unit]
Description=KINGAI A/B update health confirmation
After=local-fs.target kingaid.service
Wants=kingaid.service
ConditionPathExists=/var/lib/kingai-state/kingai/update/slots.json

[Service]
Type=oneshot
ExecStart=/usr/lib/kingai/kingai-update boot-health
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/kingai-state /boot /run
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
