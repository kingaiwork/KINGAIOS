[Unit]
Description=KINGAI OS Core Daemon
Documentation=https://os.kingai.work/docs
After=local-fs.target
Before=multi-user.target

[Service]
Type=simple
User=kingai
Group=kingai
ExecStart=/usr/lib/kingai/kingaid
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kingai
StateDirectory=kingai
LogsDirectory=kingai
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
