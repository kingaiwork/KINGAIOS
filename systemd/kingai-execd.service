[Unit]
Description=KINGAI OS Constrained Execution Broker
Documentation=https://os.kingai.work/docs
After=local-fs.target systemd-sysusers.service dbus.service
Before=kingaid.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/kingai/kingai-execd
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kingai-execd
RuntimeDirectoryMode=0711
LogsDirectory=kingai-execd
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
