{
  "agents": [
    {
      "id": "main",
      "role": "orchestrator",
      "capabilities": ["filesystem.read", "network.read", "filesystem.write"]
    },
    {
      "id": "system-ops",
      "role": "system-operations",
      "capabilities": ["filesystem.read", "network.read", "process.execute", "service.restart", "package.install", "network.modify", "boot.modify"]
    },
    {
      "id": "sec-ops",
      "role": "security-operations",
      "capabilities": ["filesystem.read", "network.read", "audit.read", "security.modify", "network.modify"]
    }
  ],
  "rule": "Agent manifests never override the central policy engine. Privileged identities are bound to trusted local service accounts or root and higher-risk capabilities still require policy approval."
}
